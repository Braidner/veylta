DATABASE_PATH=.local/veylta.sqlite
API_HOST=127.0.0.1
API_PORT=4301
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=4302
WEB_ORIGIN=http://127.0.0.1:4300
NEXT_PUBLIC_API_PATH=/health-api
API_INTERNAL_URL=http://127.0.0.1:4301
OBJECT_STORAGE_ROOT=.local/storage
# Leave the local driver enabled for the synthetic demo. The S3 driver needs an
# external least-privilege credential provider; do not put access keys here.
# OBJECT_STORAGE_DRIVER=s3
# S3_BUCKET=veylta-synthetic-bucket
# S3_REGION=eu-west-1
# S3_PREFIX=veylta
# S3_ENDPOINT=https://objects.example.test
# S3_FORCE_PATH_STYLE=true
# S3_SERVER_SIDE_ENCRYPTION=aws:kms
# S3_KMS_KEY_ID=arn:aws:kms:eu-west-1:000000000000:key/example
MAX_DOCUMENT_BYTES=5242880
PROCESSING_LEASE_DURATION_MS=60000
PROCESSING_POLL_INTERVAL_MS=500
PROCESSING_RETRY_DELAY_MS=1000
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=2592000
DEMO_REGISTRATION_ENABLED=true
CODEX_CARE_PLAN_MODEL=gpt-5.4-mini
CODEX_CARE_PLAN_TIMEOUT_MS=120000
