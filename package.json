{
  "name": "family-health",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "packageManager": "pnpm@10.4.1",
  "pnpm": {
    "ignoredOptionalDependencies": [
      "lightningcss",
      "lightningcss-*",
      "sharp"
    ]
  },
  "scripts": {
    "build": "pnpm -r build",
    "db:migrate": "pnpm --filter @family-health/api db:migrate",
    "db:rollback": "pnpm --filter @family-health/api db:rollback",
    "dev": "node scripts/dev.mjs",
    "dev:api": "pnpm --filter @family-health/api dev:api",
    "dev:web": "pnpm --filter @family-health/web dev",
    "dev:worker": "pnpm --filter @family-health/api dev:worker",
    "format": "biome format --write .",
    "license:check": "node scripts/check-licenses.mjs",
    "lint": "biome check .",
    "predev": "pnpm --filter @family-health/contracts build",
    "predev:api": "pnpm --filter @family-health/contracts build",
    "predev:web": "pnpm --filter @family-health/contracts build",
    "predev:worker": "pnpm --filter @family-health/contracts build",
    "pretest": "pnpm --filter @family-health/contracts build",
    "pretest:e2e": "pnpm --filter @family-health/contracts build",
    "pretypecheck": "pnpm --filter @family-health/contracts build",
    "test": "pnpm -r test",
    "test:e2e": "pnpm db:migrate && playwright test",
    "test:integration": "pnpm --filter @family-health/api test:integration",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
